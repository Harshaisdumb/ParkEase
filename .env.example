# ===================================================================
# ParkEase India - Environment Variables Template (.env.example)
# ===================================================================

# 1. Groq Cloud API Key (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Maps JavaScript API Key (Optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. Map Engine: 'osm' (Default Free OpenStreetMap) or 'google'
MAP_ENGINE=osm

# 4. Features
ENABLE_TRAFFIC_LAYER=true
ENABLE_ROUTING=true
