# ===================================================================
# ParkEase India - Environment Variables (.env)
# ===================================================================
# Paste your Google Maps JavaScript API Key below:
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Default Map Engine: 'google' or 'osm' (OpenStreetMap)
MAP_ENGINE=google

# Real-time traffic layer: true / false
ENABLE_TRAFFIC_LAYER=true

# Turn-by-turn driving routing: true / false
ENABLE_ROUTING=true
